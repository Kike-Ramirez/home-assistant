# Secrets — never commit the real .env, only this .example file.
ANTHROPIC_API_KEY=

MQTT_HOST=mqttbbr
MQTT_PORT=8883
MQTT_USER=bbruser
MQTT_PASSWORD=bbrpassword
MQTT_TLS_ENABLED=true

# Note: PostgREST itself (the Marketplace service) must be configured with
# PGRST_DB_ANON_ROLE=app_service — see the comment in db/schema.sql. No JWT
# and no per-request role: this is a home project, a single trusted user.
POSTGREST_URL=http://postgrest:3000
