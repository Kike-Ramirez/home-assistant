# Secrets — never commit the real .env, only this .example file.
MQTT_HOST=mqttbbr
MQTT_PORT=8883
MQTT_USER=bbruser
MQTT_PASSWORD=bbrpassword
MQTT_TLS_ENABLED=true

# Note: PostgREST itself (the Marketplace service) must be configured with
# PGRST_DB_ANON_ROLE=app_service — see the comment in db/schema.sql.
POSTGREST_URL=http://postgrest:3000

# APScheduler jobstore (SQLAlchemyJobStore) — the same Postgres that PostgREST exposes.
POSTGRES_DSN=postgresql://app_service:changeme@postgresql:5432/home
