# Secrets — never commit the real .env, only this .example file.
ANTHROPIC_API_KEY=

MQTT_HOST=mqttbbr
MQTT_PORT=8883
MQTT_USER=bbruser
MQTT_PASSWORD=bbrpassword
MQTT_TLS_ENABLED=true

# No POSTGREST_URL needed: this service never writes to Postgres directly —
# it publishes the extracted draft over MQTT, and orchestrator saves it once
# the user confirms.
